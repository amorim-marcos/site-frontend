{
  "name": "react-avancado-boilerplate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "test": "jest --maxWorkers=50%",
    "test:watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand",
    "generate": "yarn plop --plopfile generators/plopfile.js",
    "storybook": "start-storybook -s ./public -p 6006",
    "build-storybook": "build-storybook -s ./public",
    "postinstall": "husky install",
    "prepare": "husky install",
    "unprepare": "husky uninstall"
  },
  "lint-staged": {
    "src/**/*": [
      "yarn lint --fix",
      "yarn test --findRelatedTests --bail"
    ]
  },
  "dependencies": {
    "@chakra-ui/icons": "^1.1.1",
    "@chakra-ui/react": "^1.7.3",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@googlemaps/react-wrapper": "^1.1.27",
    "dompurify": "^2.3.5",
    "framer-motion": "^4",
    "i18next": "^21.6.3",
    "i18next-browser-languagedetector": "^6.1.2",
    "install": "^0.13.0",
    "isomorphic-dompurify": "^0.18.0",
    "meilisearch": "^0.24.0",
    "next": "11.1.2",
    "next-pwa": "^5.3.1",
    "ni18n": "^1.0.3-rc.0",
    "npm": "^8.4.0",
    "react": "17.0.2",
    "react-cookie-consent": "^7.3.1",
    "react-dom": "17.0.2",
    "react-html-parser": "^2.0.2",
    "react-i18next": "^11.15.1",
    "react-icons": "^4.3.1",
    "react-router-dom": "^6.2.1",
    "react-router-hash-link": "^2.4.3",
    "react-scroll": "^1.8.4",
    "react-share": "^4.4.0",
    "react-swipeable": "^6.2.0",
    "styled-components": "5.3.1",
    "tsconfig-paths-webpack-plugin": "^3.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.15.8",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.16.5",
    "@babel/plugin-proposal-optional-chaining": "^7.16.5",
    "@babel/preset-typescript": "^7.15.0",
    "@storybook/addon-essentials": "6.3.10",
    "@storybook/react": "6.3.10",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.1.2",
    "@types/ckeditor__ckeditor5-build-classic": "^29.0.1",
    "@types/dompurify": "^2.3.3",
    "@types/google.maps": "^3.48.2",
    "@types/jest": "^27.0.2",
    "@types/node": "^16.10.3",
    "@types/react": "^17.0.27",
    "@types/react-html-parser": "^2.0.2",
    "@types/react-router-hash-link": "^2.4.5",
    "@types/react-scroll": "^1.8.3",
    "@types/styled-components": "^5.1.15",
    "@typescript-eslint/eslint-plugin": "rc-v5",
    "@typescript-eslint/parser": "rc-v5",
    "babel-loader": "^8.2.2",
    "babel-plugin-styled-components": "^1.13.2",
    "eslint": "^8.7.0",
    "eslint-config-next": "^11.1.2",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.26.1",
    "eslint-plugin-react-hooks": "^4.2.0",
    "husky": "^7.0.2",
    "jest": "^27.2.5",
    "jest-styled-components": "^7.0.5",
    "lint-staged": "^11.2.3",
    "plop": "^2.7.4",
    "prettier": "^2.4.1",
    "storybook-addon-next-router": "^3.0.8",
    "storybook-react-i18next": "^1.0.13",
    "typescript": "^4.4.3"
  }
}
